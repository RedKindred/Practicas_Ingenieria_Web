<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Recuperar Contraseña</title>
    <link rel="stylesheet" href="../css/style.css">
</head>
<body>
    <div class="form-container">
        <h2>Recuperar Contraseña</h2>

        <!-- Paso 1: buscar usuario -->
        <div id="paso-1">
            <input type="email" id="buscar-email" placeholder="Correo">
            <span class="mensaje" id="error-buscar-email"></span>
            <button onclick="buscarUsuario()">Buscar</button>
        </div>

        <!-- Paso 2: validar respuesta -->
        <div id="paso-2" style="display:none;">
            <p id="pregunta-mostrada"></p>
            <input type="text" id="respuesta-user" placeholder="Tu respuesta">
            <span class="mensaje" id="error-respuesta-user"></span>
            <button onclick="validarRespuesta()">Validar</button>
        </div>

        <!-- Paso 3: nueva contraseña -->
        <div id="paso-3" style="display:none;">
            <input type="password" id="nueva-pass"
                pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"
                placeholder="Nueva contraseña"
                autocomplete="new-password">
            <span class="mensaje" id="error-nueva-pass"></span>

            <input type="password" id="nueva-conf"
                placeholder="Confirmar nueva contraseña"
                autocomplete="new-password">
            <span class="mensaje" id="error-nueva-conf"></span>

            <button onclick="cambiarContrasena()">Cambiar contraseña</button>
        </div>

        <p id="resultado"></p>
        <a href="/login">Volver</a>
    </div>

    <script src="../js/validarFormRecuperar.js"></script>

</body>
</html>
